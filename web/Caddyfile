{$SITE_ADDRESS::80} {
	handle /v1/races/*/stream {
		reverse_proxy {$SSE_UPSTREAM:sse:3001} {
			flush_interval -1
		}
	}

	handle /v1/* {
		encode zstd gzip
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /assets/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
