          "expr": "(1 - (((sum(rate(ars_bet_acceptance_duration_seconds_bucket{phase=\"pre\",le=\"2\"}[1h])) or vector(0)) + (sum(rate(ars_bet_acceptance_duration_seconds_bucket{phase=\"live\",le=\"2.5\"}[1h])) or vector(0))) / (sum(rate(ars_bet_acceptance_duration_seconds_count[1h]))))) / 0.01",
          "legendFormat": "Bet decisions",
          "refId": "C",
          "editorMode": "code",
          "range": true
