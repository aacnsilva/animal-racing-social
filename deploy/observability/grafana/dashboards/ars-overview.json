          "legendFormat": "Settlement",
          "refId": "D",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "(1 - ((sum(rate(http_server_request_duration_seconds_count{job=\"api\",http_response_status_code!~\"5..\"}[1h]))) / (sum(rate(http_server_request_duration_seconds_count{job=\"api\"}[1h]))))) / 0.005",
          "legendFormat": "API availability",
          "refId": "E",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "(1 - (((sum(rate(http_server_request_duration_seconds_bucket{job=\"api\",http_request_method=\"GET\",le=\"0.3\"}[1h])) or vector(0)) + (sum(rate(http_server_request_duration_seconds_bucket{job=\"api\",http_request_method!=\"GET\",le=\"0.8\"}[1h])) or vector(0))) / (sum(rate(http_server_request_duration_seconds_count{job=\"api\"}[1h]))))) / 0.05",
