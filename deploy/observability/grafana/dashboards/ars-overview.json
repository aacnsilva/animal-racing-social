            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "(1 - ((sum(sum_over_time((((max(ars_outbox_oldest_age_seconds) or vector(0)) < bool 10) * ((max(sum by (consumergroup) (kafka_consumergroup_uncommitted_offsets_sum{consumergroup=~\"bet-worker|settlement|wallet|market-manager\"})) or vector(0)) < bool 1000))[1h:1m]))) / (sum(count_over_time((max(ars_outbox_oldest_age_seconds) or vector(0))[1h:1m]))))) / 0.01",
          "legendFormat": "Event pipeline",
